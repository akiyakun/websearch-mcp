OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Generate a separate token; do not use your OpenAI key here.
WEBSEARCH_MCP_TOKEN=
# Default is localhost only. For LAN use, set BOTH to the NAS's LAN IP.
MCP_BIND_IP=127.0.0.1
SERVER_IP=127.0.0.1
# Host port only; the container listens on 8000.
MCP_PORT=8101
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
SEARCH_MAX_OUTPUT_TOKENS=1200
SEARCH_MAX_CALLS_PER_WINDOW=50
SEARCH_WINDOW_SECONDS=60
SEARCH_MAX_CALLS_PER_DAY=500
SEARCH_MAX_TOKENS_PER_DAY=500000
SEARCH_TOKEN_RESERVATION=12000
SEARCH_BUDGET_TIMEZONE=Asia/Tokyo
